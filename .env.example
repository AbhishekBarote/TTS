# ==============================================================================
# Centralized Audio Research & Revalidation Workflow - Configuration
# ==============================================================================

# 1. YouTube Data API v3 (Optional)
# If provided, official Google YouTube Data API v3 will be used for metadata.
# If left blank, the system automatically uses YouTube's public oEmbed & web fetcher.
YOUTUBE_API_KEY=

# 2. LLM Pre-Filter Configuration (Optional)
# Used for automated semantic duplicate detection and dialect analysis.
# Can also be configured directly via the "🤖 LLM Pre-Filter" button in the web UI.
LLM_BASE_URL=https://api.openai.com/v1
LLM_ENDPOINT_PATH=/chat/completions
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
